<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- The Bell's dings, through a UnifiedPush distributor (docs/design.md §3, §5).
             The connector's own manifest brings the distributor <queries>, its receiver
             and WAKE_LOCK; this is the one part the app declares itself. -->
        <service
            android:name="app.monokular.push.WakePushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
